(defwidget bar []
  (centerbox :orientation "v"
    (logo)
    (workspaces)
    (sidestuff)))

(defwidget logo []
  (box :class "logo" 
        :orientation "v"
        :space-evenly false
        :halign "center"
        :valign "start"
    (button :onclick "wmctrl -s 0" "󰣇")))

(defwidget workspaces []
  (box :class "workspaces"
       :orientation "v"
       :space-evenly true
       :halign "center"
       :valign "center"
    (button :onclick "wmctrl -s 0" "󰬺")
    (button :onclick "wmctrl -s 1" "󰬻")
    (button :onclick "wmctrl -s 2" "󰬼")
    (button :onclick "wmctrl -s 3" "󰬽")
    (button :onclick "wmctrl -s 4" "󰬾")))

(defwidget sidestuff []
  (box :class "sidestuff" 
        :orientation "v"
        :space-evenly false
        :halign "center"
        :valign "end"
    (network)
    (clock)))

(defwidget network []
    (box :orientation "v" 
		:class "network" 
		:valign "end"
	(box "󰤨")
	(box "")))

(defwidget clock []
	(box :orientation "v" 
		:class "clock" 
		:valign "end"
	(button	:class "time-hour" hour)
	(button	:class "time-min"  minutes)))
(defpoll hour :interval "1s" "date '+%H'")
(defpoll minutes :interval "1s"	"date '+%M'")

(defwindow bar
  :monitor 0
  :windowtype "dock"
  :exclusive true
  :geometry (geometry :x "20px"
                      :y "0%"
                      :width "50px"
                      :height "98%"
                      :anchor "left center")
  :reserve (struts :side "left" :distance "4%")
  (bar))
